# Copy to .env for local development. Never commit the real .env.

# Flask ----------------------------------------------------------------
FLASK_ENV=development
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database -------------------------------------------------------------
# Leave blank locally to use a SQLite file (local.db).
# Render injects the real Postgres URL automatically.
DATABASE_URL=

# Encryption at rest ---------------------------------------------------
# Comma-separated Fernet keys. The FIRST key encrypts new writes; older keys
# stay in the list so existing rows still decrypt while you rotate.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up somewhere safe. Lose it and every stored record is unreadable.
FIELD_ENCRYPTION_KEYS=

# Blind index ----------------------------------------------------------
# Keys the HMAC used to find encrypted usernames and email addresses at
# sign-in. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER change this once accounts exist -- every lookup value changes with it
# and nobody will be able to sign in.
BLIND_INDEX_KEY=

# Password hashing (Argon2id) ------------------------------------------
# Optional. Each concurrent hash allocates ARGON2_MEMORY_KIB in full, so the
# default suits Render's free 512 MB tier. Raise it on a larger instance.
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_KIB=32768
# ARGON2_PARALLELISM=1

# Host access ----------------------------------------------------------
# Comma-separated emails allowed to read /admin/tag-requests.
ADMIN_EMAILS=

# Tag request notifications (optional) ---------------------------------
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
